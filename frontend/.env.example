# Event Management System - Frontend Environment Variables

# VITE_API_BASE_URL is the URL of the FastAPI backend.
#
# Development  : http://localhost:8000
# Production   : https://event-management-api-aw25.onrender.com
#
# When unset, the app falls back to the environment-appropriate default:
#   `npm run dev`  -> http://localhost:8000
#   `npm run build` -> https://event-management-api-aw25.onrender.com
#
# Copy this file to `.env.local` (local overrides) or `.env.production`
# (local production builds) to override the default, or set the variable
# in your shell / CI (e.g. Vercel project settings).

VITE_API_BASE_URL=http://localhost:8000
