# Event Management System - Backend

# PostgreSQL Database Configuration
# Update the password below with your actual PostgreSQL password
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_actual_password_here
DB_NAME=event_management

# JWT Configuration (for later phases)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
DEBUG=True

# Email / Password Reset (Resend)
# Get an API key from https://resend.com/api-keys — never commit a real key
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=EventPro <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=15
