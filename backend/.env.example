# Event Management System - Backend

# PostgreSQL Database Configuration
# ---------------------------------------------------------------------------
# Development: set DATABASE_URL to your LOCAL PostgreSQL (never the production
# Render/Neon URL — that would read and write live data).
#
# Production: Render overrides DATABASE_URL from the service environment
# variables (e.g. your Neon connection string).
#
# DATABASE_URL takes priority over the individual DB_* fields below.
DATABASE_URL=postgresql://postgres:your_actual_password_here@localhost:5432/event_management

# Alternatively, provide the connection parts instead of a full DATABASE_URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_actual_password_here
# DB_NAME=event_management

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
DEBUG=True

# CORS - comma-separated list of frontend origins allowed to call this API.
# Defaults already cover the local Vite dev servers and the Vercel production
# origin, so this usually doesn't need changing.
# CORS_ORIGINS=http://localhost:5173,https://event-management-system-ruby-gamma.vercel.app

# Email / Password Reset (Resend)
# Get an API key from https://resend.com/api-keys — never commit a real key
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=EventPro <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=15
